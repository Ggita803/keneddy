    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: box-shadow 0.3s, background 0.3s;
}

[data-theme="dark"] .glass-card {
    background: rgba(31, 41, 55, 0.4);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Dark mode toggle button */
#darkModeToggle {
    transition: transform 0.3s ease, background-color 0.3s ease;
}

#darkModeToggle:hover {
    transform: rotate(20deg) scale(1.1);
}

/* Toast notification styling */
.toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: linear-gradient(135deg, #1e3a8a 0%, #f59e0b 100%);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    z-index: 1000;
    animation: slideInRight 0.3s ease-out, slideLeft 0.3s ease-in 2.7s forwards;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    max-width: 300px;
}

@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(400px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes slideOutRight {
    from {
        opacity: 1;
        transform: translateX(0);
    }
    to {
        opacity: 0;
        transform: translateX(400px);
    }
}

/* Responsive for mobile toast */
@media (max-width: 640px) {
    .toast {
        bottom: 1rem;
        right: 1rem;
        left: 1rem;
        max-width: none;
    }
}

/* Testimonial carousel */
.carousel-container {
    position: relative;
    overflow: hidden;
}

.carousel-slide {
    animation: fadeInUp 0.6s ease-out forwards;
}

.carousel-controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
}

.carousel-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #d1d5db;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.carousel-dot.active {
    background-color: #1e3a8a;
    border-color: #f59e0b;
    transform: scale(1.2);
}

/* Policy accordion */
.policy-chevron {
    transition: transform 0.3s ease;
}

.policy-chevron.rotated {
    transform: rotate(180deg);
}

/* Counter animation */
.counter {
    animation: countUp 1s ease-out;
}

/* Material Design ripple on click */
button, a.transition {
    position: relative;
}

button:active::after, a.transition:active::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    animation: rippleEffect 0.6s ease-out;
    pointer-events: none;
}

@keyframes rippleEffect {
    to {
        width: 300px;
        height: 300px;
        opacity: 0;
        transform: translate(-50%, -50%);
    }
}

/* Smooth transitions for form inputs */
input, textarea, select {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

input:focus, textarea:focus, select:focus {
    border-color: #1e3a8a !important;
    box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.1);
}

